    "args_linux": ["new", "blazorwasm", "-o", "{project_name}"],
    "dependencies": [
      {"name": ".NET SDK", "link": "https://dotnet.microsoft.com/download"}
    ]
  },
    {
    "name": "Django",
    "description": "High-level Python web framework",
    "category": "WebFramework",
    "tool_windows": "cmd",
