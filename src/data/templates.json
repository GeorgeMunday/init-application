[
  {
    "name": "Next.js",
    "description": "Full-stack React framework",
    "category": "WebFramework",
    "tool_windows": "cmd",
    "tool_linux": "npx",
    "args_windows": ["/C", "npx", "create-next-app@latest", "{project_name}", "--yes"],
    "args_linux": ["create-next-app@latest", "{project_name}", "--yes"],
    "dependencies": [
      {"name": "Node.js", "link": "https://nodejs.org/"}
    ]
  },
  {
    "name": "Angular",
    "description": "Lean component-driven app",
    "category": "WebFramework",
    "tool_windows": "cmd",
    "tool_linux": "npx",
    "args_windows": ["/C", "npx", "-p", "@angular/cli", "ng", "new", "{project_name}", "--defaults", "--skip-git"],
    "args_linux": ["-p", "@angular/cli", "ng", "new", "{project_name}", "--defaults", "--skip-git"],
    "dependencies": [
      {"name": "Node.js", "link": "https://nodejs.org/"}
    ]
  },
  {
    "name": "Blazor",
    "description": "C# web UI application",
    "category": "WebFramework",
    "tool_windows": "cmd",
